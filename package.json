{
  "name": "codeintel-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "codeintelligence/apps/*"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
"scripts": {
  "dev:backend": "cd codeintelligence/apps/ai-backend && venv\\Scripts\\python -X utf8 -m uvicorn main:app --reload --port 8000",
  "dev:frontend": "cd codeintelligence/apps/web && npm run dev",
  "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
}
}